# Application
APP_NAME="AI Vision Platform"
APP_VERSION="1.0.0"
DEBUG=True
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ai_vision_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=0

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# AI Models
MODEL_PATH=./models
PPE_MODEL_PATH=./models/ppe_detection.pt
FALL_MODEL_PATH=./models/fall_detection.pt
FIRE_MODEL_PATH=./models/fire_smoke_detection.pt
CONFIDENCE_THRESHOLD=0.5
IOU_THRESHOLD=0.45

# Video Processing
MAX_VIDEO_SIZE_MB=500
SUPPORTED_VIDEO_FORMATS=["mp4", "avi", "mov", "mkv"]
FRAME_RATE=30
VIDEO_RESOLUTION_WIDTH=1920
VIDEO_RESOLUTION_HEIGHT=1080

# WebSocket
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=100

# Storage
UPLOAD_DIR=./uploads
DETECTION_RESULTS_DIR=./results
MAX_STORAGE_GB=100

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Email (for alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@aivision.com

# Monitoring
ENABLE_METRICS=True
METRICS_PORT=9090

